# Copy to .env and fill in. All are read by app/config.py (pydantic-settings).

# --- Job source (JSearch / OpenWeb Ninja) ---
JSEARCH_API_KEY=
# JSEARCH_COUNTRY=in

# --- RAG service (existing, external) ---
# RAG_BASE_URL=http://localhost:8001

# --- Hugging Face Inference Providers ---
HF_TOKEN=

# --- Models (override only if needed; sensible defaults in config.py) ---
# CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
